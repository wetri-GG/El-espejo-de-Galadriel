<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://android.com"
    xmlns:app2="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://android.com"
    xmlns:tools2="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0C"
    android:padding="28dp"
    tools:context=".MainActivity">

    <!-- Encabezado de la Asignatura y Código de Centro -->

    <!-- Panel contenedor central para organizar los ejercicios -->

    <!-- Pie de página informativo del Framework -->

    <TextView
        android:id="@+id/tvCodigoAsignatura"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.1"
        android:text="2627 - IAX - Prg. MDM"
        android:textColor="#9E9E9E"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools2:layout_editor_absoluteX="29dp"
        tools2:layout_editor_absoluteY="38dp" />

    <TextView
        android:id="@+id/tvTituloUT"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UT6: Gestión Multimedia"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCodigoAsignatura"
        tools2:layout_editor_absoluteX="46dp"
        tools2:layout_editor_absoluteY="120dp" />

    <LinearLayout
        android:id="@+id/containerMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="182dp"
        android:gravity="center"
        android:orientation="vertical"
        app2:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTituloUT"
        tools2:layout_editor_absoluteX="46dp">

        <!-- SUBTÍTULO: SECCIÓN AUDIO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:letterSpacing="0.05"
            android:text="🎶 BLOQUE I: AUDIO LOCAL"
            android:textColor="#A29BFE"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Práctica 1: Campanas de Gondor / Laúd -->

        <!-- SUBTÍTULO: SECCIÓN VÍDEO -->
        <Button
            android:id="@+id/btnIrAudio"
            android:layout_width="280dp"
            android:layout_height="58dp"
            android:layout_marginBottom="36dp"
            android:backgroundTint="#6C5CE7"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Las Campanas de Gondor"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:letterSpacing="0.05"
            android:text="👁️ BLOQUE II: STREAMING WEB"
            android:textColor="#FAB1A0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Práctica 2: El Palantír de Saruman (Incrustación WebView) -->
        <Button
            android:id="@+id/btnIrVideo"
            android:layout_width="280dp"
            android:layout_height="58dp"
            android:backgroundTint="#E17055"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="El Palantír de Saruman"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Entorno de Trabajo Autónomo • Android Studio"
        android:textColor="#424242"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools2:layout_editor_absoluteX="125dp"
        tools2:layout_editor_absoluteY="85dp" />

</androidx.constraintlayout.widget.ConstraintLayout>